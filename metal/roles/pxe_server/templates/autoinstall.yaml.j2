autoinstall:
  version: 1
  identity:
    hostname: {{ item }}
    username: ubuntu
    password: {{ hashed_passwd | quote }}
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - {{ ssh_public_key }}
  late-commands:
    - curtin in-target --target=/target -- sh -c 'echo "ubuntu ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/ubuntu'
    - curtin in-target --target=/target -- chmod 0440 /etc/sudoers.d/ubuntu
  network:
    version: 2
    ethernets:
      eno1:
        match:
          macaddress: {{ hostvars[item]["mac"] | quote }}
        dhcp4: false
        addresses:
          - {{ hostvars[item]["ansible_host"] }}/{{ (ansible_facts['default_ipv4']['address'] + '/' + ansible_facts['default_ipv4']['netmask']) | ansible.utils.ipaddr('prefix') }}
        routes:
          - to: default
            via: {{ pxe_gateway }}
        nameservers:
          addresses:
            - 8.8.8.8
            - 1.1.1.1
  storage:
    config:
      - grub_device: false
        id: {{ hostvars[item]["disk"] }}
        path: /dev/{{ hostvars[item]["disk"] }}
        ptable: gpt
        type: disk
        wipe: superblock-recursive
        preserve: false
      - device: {{ hostvars[item]["disk"] }}
        flag: boot
        id: efi-partition
        number: 1
        size: 1G
        type: partition
        grub_device: true
      - fstype: fat32
        id: efi-format
        type: format
        volume: efi-partition
        label: ESP
      - device: efi-format
        id: mount-efi-partition
        path: /boot/efi
        type: mount
      - device: {{ hostvars[item]["disk"] }}
        id: boot-partition
        number: 2
        size: 2G
        type: partition
      - fstype: ext4
        id: boot-format
        type: format
        volume: boot-partition
        label: BOOT
      - device: boot-format
        id: mount-boot-partition
        path: /boot
        type: mount
      - type: partition
        number: 3
        id: lvm-partition
        device: {{ hostvars[item]["disk"] }}
        size: -1
        grub_device: false
      - name: system
        devices:
          - lvm-partition
        preserve: false
        type: lvm_volgroup
        id: lvm-volgroup-system
      - name: root
        volgroup: lvm-volgroup-system
        size: {{ hostvars[item]["root_disk_size"] }}
        wipe: superblock
        preserve: false
        type: lvm_partition
        id: lvm-partition-root
      - fstype: xfs
        volume: lvm-partition-root
        preserve: false
        type: format
        id: format-root
      - path: /
        device: format-root
        type: mount
        id: mount-root
{% for cd in hostvars[item]["ceph_disks"] | default([]) %}
      - id: {{ cd }}
        path: /dev/{{ cd }}
        ptable: gpt
        type: disk
        wipe: superblock-recursive
{% endfor %}
